@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Page Not Found";
}

<section class="notfound-section" style="text-align:center; padding:80px 0;">
    <h1 style="font-size:60px; font-weight:bold;">404</h1>
    <h2 style="margin-bottom:20px;">Page Not Found</h2>
    <p>The page you are looking for does not exist.</p>

    <a asp-controller="Home" asp-action="Index" class="btn-yellow" style="margin-top:30px;">
        Go Back Home
    </a>
</section>
