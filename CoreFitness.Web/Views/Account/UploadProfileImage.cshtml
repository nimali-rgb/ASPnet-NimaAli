@{
    ViewData["Title"] = "Byt profilbild";
}

<div class="container mt-4">
    <h2>Byt profilbild</h2>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="UploadProfileImage" asp-controller="Account" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Välj bild</label>
            <input type="file" name="file" class="form-control" />
        </div>

        <button class="btn btn-primary">Ladda upp</button>
        <a href="/MyPage" class="btn btn-secondary">Tillbaka</a>
    </form>
</div>
