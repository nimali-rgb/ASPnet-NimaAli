@model IEnumerable<CoreFitness.Domain.Entities.Booking>
@{
    Layout = "_HomeLayout";
}

<h2>My Bookings</h2>

<table>
    <tr>
        <th>Class</th>
        <th>Date</th>
        <th>Time</th>
        <th></th>
    </tr>

    @foreach (var b in Model)
    {
        <tr>
            <td>@b.GymClass.Name</td>
            <td>@b.GymClass.Date.ToShortDateString()</td>
            <td>@b.GymClass.Time</td>
            <td>
                <form asp-action="Cancel" asp-route-id="@b.Id" method="post">
                    <button type="submit">Cancel</button>
                </form>
            </td>
        </tr>
    }
</table>
