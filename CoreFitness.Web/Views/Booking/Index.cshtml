@model IEnumerable<CoreFitness.Domain.Entities.Booking>

<h1>Mina bokningar</h1>

@if (!Model.Any())
{
    <p>Du har inga bokningar ännu.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Pass</th>
                <th>Datum</th>
                <th>Tid</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.GymClass.Name</td>
                    <td>@booking.GymClass.Date.ToShortDateString()</td>
                    <td>@booking.GymClass.Time</td>
                    <td>
                        <a asp-controller="Booking" asp-action="Cancel" asp-route-id="@booking.Id" class="btn btn-danger">
                            Avboka
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
