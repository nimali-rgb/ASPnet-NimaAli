@model IEnumerable<CoreFitness.Domain.Entities.GymClass>

<div class="container mt-4">
    <h2 class="mb-3">Tillgängliga träningspass</h2>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p>Inga träningspass finns tillgängliga just nu.</p>
        <p>Skapa ett nytt pass i adminpanelen.</p>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var booked = item.Bookings?.Count() ?? 0;
                var remaining = item.Capacity - booked;

                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4 class="card-title">@item.Name</h4>

                            <p class="card-text mb-1">
                                <strong>Datum:</strong> @item.Date.ToShortDateString()
                            </p>

                            <p class="card-text mb-1">
                                <strong>Tid:</strong> @item.Time.ToString(@"hh\:mm")
                            </p>

                            <p class="card-text mb-1">
                                <strong>Kapacitet:</strong> @item.Capacity
                            </p>

                            <p class="card-text mb-1">
                                <strong>Platser kvar:</strong> @remaining
                            </p>

                            <p class="card-text mb-3">
                                <strong>Tränare:</strong> @item.Teacher?.Name ?? "Ingen tränare"
                            </p>

                            @if (remaining > 0)
                            {
                                <a asp-controller="Booking"
                                   asp-action="Create"
                                   asp-route-gymClassId="@item.Id"
                                   class="btn btn-primary w-100">
                                    Boka pass
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-danger w-100 p-2 text-center">Fullt</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
