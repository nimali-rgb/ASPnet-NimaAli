@model IEnumerable<CoreFitness.Domain.Entities.GymClass>

<h2>Gym Classes</h2>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Instructor</th>
            <th>Date</th>
            <th>Time</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Instructor</td>
                <td>@c.Date.ToShortDateString()</td>
                <td>@c.Time</td>
                <td>@c.Category</td>
            </tr>
        }
    </tbody>
</table>
