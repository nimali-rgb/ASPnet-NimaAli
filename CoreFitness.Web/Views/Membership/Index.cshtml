@{
    Layout = "_HomeLayout";
}

<section class="membership-section">

    <div class="membership-grid">

        <!-- Standard -->
        <div class="membership-card">
            <h2>Standard Membership</h2>
            <ul>
                <li>Access to full range of gym facilities</li>
                <li>Standard locker</li>
                <li>High-energy group fitness classes</li>
                <li>Motivating and supportive environment</li>
            </ul>
            <p class="price">495.00 /monthly</p>
            <p class="note">* Monthly 20 Classes</p>
            <a class="btn-yellow">Join Now</a>
        </div>

        <!-- Premium -->
        <div class="membership-card premium">
            <h2>Premium Membership</h2>
            <ul>
                <li>Everything in Standard</li>
                <li>Priority support & premium locker</li>
                <li>High-energy group fitness classes</li>
                <li>Motivating and supportive environment</li>
            </ul>
            <p class="price">595.00 /monthly</p>
            <p class="note">* Monthly 20 Classes</p>
            <a class="btn-yellow">Join Now</a>
        </div>

        <!-- Contact -->
        <div class="membership-card contact">
            <h2>Get Your Membership</h2>
            <p>Memberships give access to all equipment and personalized training.</p>
            <p class="contact-number">Call Us At: +(46) 8 410 521 00</p>
            <a class="btn-yellow">Call Us Today!</a>

            <img src="/images/membershipimges1.png" class="contact-img" />
        </div>

    </div>

</section>

<div class="membership-icons">
    <div class="icon-item">
        <img src="/images/freeTrial.png" class="icon-img" />
        <span>Get 30 day free trial</span>
    </div>

    <div class="icon-item">
        <img src="/images/noPay.png" class="icon-img" />
        <span>No hidden fees</span>
    </div>

    <div class="icon-item">
        <img src="/images/cancel.png" class="icon-img" />
        <span>Cancel anytime</span>
    </div>
</div>
